# Copy to .env and fill in real values. Never commit .env.
# If querySrv ECONNREFUSED persists, use Atlas "Standard connection string" (mongodb://...) — no SRV lookup.
# On non-Windows, set MONGO_DNS_USE_PUBLIC=true if SRV DNS fails. MONGO_DNS_USE_SYSTEM=true opts out of public DNS.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=7d
PORT=5001
CLIENT_URL=http://localhost:5173
